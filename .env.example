# Copy to .env for local Compose use; never commit the filled file.
# The organizer provides a read-only MongoDB URI and approved provider settings.
OPENAI_API_KEY=
OPENAI_MODEL=
MONGODB_URI=
MONGODB_DATABASE=bank_milestone
# Used only when running Streamlit outside Compose; Compose uses http://api:8000.
BANK_API_URL=http://127.0.0.1:8000
DEMO_PERSONAS_PATH=demo_personas.json
